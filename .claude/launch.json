{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "meetrao-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "meetrao",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "meetrao-prod-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "meetrao",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}

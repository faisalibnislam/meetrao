# Build-time defaults for production deployments.
#
# Only values that are PUBLIC by design live here — they are inlined into the
# browser bundle anyway, and every read they can make is bounded by RLS. The
# secret key is deliberately absent; set SUPABASE_SERVICE_ROLE_KEY on the
# hosting platform instead.
#
# Real environment variables take precedence over this file, so anything set in
# the Vercel dashboard overrides these without an edit here.

NEXT_PUBLIC_SUPABASE_URL=https://gpighkgvdiphdtpqpsfr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_5rzEIFC1bN7WEMbAKNaFgQ_ClYiZQTZ

# The seeded demo host, so the landing page's second CTA opens a real booking page.
NEXT_PUBLIC_DEMO_USERNAME=faisal

# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_BOOKING_HOST are intentionally unset:
# both fall back to the deployment's own domain. Set NEXT_PUBLIC_SITE_URL once a
# custom domain serves the app, since the Google OAuth redirect URI must match
# it exactly.

# ── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The publishable/anon key is safe in the browser;
# every read it can make is bounded by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Either the newer `sb_publishable_...` key or a legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# SECRET. Bypasses RLS entirely — server-side only, never NEXT_PUBLIC_.
# Accepts either format: the newer `sb_secret_...` key or a legacy service_role
# JWT. Both map to the same Postgres role.
# Used for exactly three things: Google OAuth tokens, creating a booking, and
# serving a guest their own booking by reference.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar ────────────────────────────────────────────────────────
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). See README for the exact scopes and redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ───────────────────────────────────────────────────────────────────
# Absolute origin of this deployment. Used to build the OAuth redirect URI, so
# it must match what is registered in Google Cloud exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host shown inside booking links in the UI, e.g. "meetrao.com/faisal".
# Cosmetic only — routing always uses NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BOOKING_HOST=meetrao.com

# Optional. Username of a public demo account. When set, the landing page's
# secondary CTA opens that real booking page; when empty it links to the
# "How it works" section instead of somewhere that would 404.
NEXT_PUBLIC_DEMO_USERNAME=

# ── Transactional email (Resend) ───────────────────────────────────────────
# SECRET. Without it every send is skipped with a warning and the action it
# follows still succeeds — a booking is still made, an account still created.
RESEND_API_KEY=

# The From address. Resend will not deliver until the sending domain is
# verified with SPF and DKIM.
RESEND_FROM=Meetrao <hello@meetrao.com>

# Where the contact form's messages go, and the reply-to on welcome mail.
SUPPORT_EMAIL=hello@airlystudio.com

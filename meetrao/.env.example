# Copy to .env.local and fill in. .env.local is gitignored and does NOT travel to
# Vercel — set every one of these in the Vercel dashboard as well.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Reaches past RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Cloud ────────────────────────────────────────────────────────────
# One OAuth client, two separate concerns:
#   Sign-in with Google — handled by Supabase Auth; its callback goes in the
#     Supabase dashboard (https://<project>.supabase.co/auth/v1/callback).
#   Calendar access — handled by us, scope calendar.events (write-with-attendees,
#     not read-only free/busy, because the guest is an attendee). Its redirect
#     URI is our own route and must be registered for EVERY origin:
#       http://localhost:3000/api/google/callback
#       https://<vercel-preview-domain>/api/google/callback
#       https://<production-domain>/api/google/callback
#     A missing one fails as redirect_uri_mismatch and nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend ──────────────────────────────────────────────────────────────────
# Until DKIM verifies, Resend delivers only to the account owner's own address.
RESEND_API_KEY=
# Both of the next two are OPTIONAL, and their defaults in src/lib/env.ts are
# already the real values. Setting either here or in the Vercel dashboard
# OVERRIDES the code — an old value left in a dashboard is how production keeps
# sending a retired address long after the repo stopped containing one.
#   EMAIL_FROM            defaults to  Meetrao <hello@meetrao.com>
#   EMAIL_POSTAL_ADDRESS  defaults to  the address in src/lib/contact.ts
# A full physical address — street, city, postcode, country. A city alone does
# not satisfy CAN-SPAM, and bulk filters read this footer too.
EMAIL_FROM=
EMAIL_POSTAL_ADDRESS=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Convex ──────────────────────────────────────────────────────────────────
# The migration target. `npx convex dev` writes the first two itself.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Which domains Convex serves, comma separated, or "all" / "none".
# UNSET MEANS SUPABASE — a variable nobody has thought about must not move
# production onto a backend nothing has reconciled. Turning a domain on makes
# Convex authoritative for it: turning the flag back off does NOT carry the
# writes home. See src/lib/backend.ts and docs/convex-migration-status.md.
#   analytics,notifications,contacts,schedules,availability,meetings,
#   bookings,publicBooking,session,admin
CONVEX_BACKENDS=

      {
        "selector": "JSXOpeningElement[name.name='KeyValueRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|mono|keyWidth|style|key|ref|className|style|children)$/]",
        "message": "<KeyValueRow> doesn't accept that prop. Declared props: label, value, mono, keyWidth, style."
